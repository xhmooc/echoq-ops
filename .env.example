# 已有小红书登录 Cookie（可选；也可以在「账号」页导入或扫码）
COOKIES=''

# 运营台监听地址与端口（只监听本机，不要改成 0.0.0.0）
OPS_HOST='127.0.0.1'
OPS_PORT='8710'

# 数据目录（默认 datas/ops，包含数据库、配图、日志；密钥不放这里）
# OPS_DATA_DIR='datas/ops'

# Cookie 加密密钥（默认 %LOCALAPPDATA%\EchoQ-Ops\secret.key，与数据目录分离）
# 旧版的 datas/ops/secret.key 会在首次启动时自动迁移。
# OPS_KEY_PATH='C:\Users\you\AppData\Local\EchoQ-Ops\secret.key'

# 文案模型超时（秒）：单次硬超时 / 一次生成总预算 / 接口兜底 / 配图渲染兜底
# 模型失败会优先用离线模板返回，不会让页面一直转圈。
# OPS_LLM_TIMEOUT_SEC='45'
# OPS_LLM_TOTAL_BUDGET_SEC='60'
# OPS_COPY_TIMEOUT_SEC='75'
# OPS_RENDER_TIMEOUT_SEC='240'

# 已发布内容同步（大账号可调大单次翻页数与列表查询上限）
# OPS_SYNC_MAX_PAGES='20'
# OPS_PUBLISHED_QUERY_LIMIT='2000'

# 模拟发布：1 = 不真正发到平台，只写模拟记录，用于演练
OPS_DRY_RUN=''

# EchoQ-Cloud 账号服务：登录、订阅校验、文案/配图中转都走这里。
# 本地开发默认 127.0.0.1:8787；正式环境改成 https 域名。
OPS_CLOUD_BASE_URL='http://127.0.0.1:8787'

# 文案模型（必须在中转白名单内，云端默认 deepseek-chat）
# OPS_LLM_MODEL='deepseek-chat'

# 上游 Key 只保存在云端，本机不再配置：
# OPS_LLM_API_KEY / OPS_IMAGE_API_KEY / DASHSCOPE_API_KEY 已废弃。

# 配图预设目录（baoyu-xhs-images）
# 找不到时自动回退内置 12 种风格，接口不会返回空列表。
# OPS_BAOYU_XHS_SKILL='C:\path\to\baoyu-xhs-images'

# 无头截图浏览器（可选；不填时自动探测 Edge / Chrome）
# OPS_BROWSER='C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'
